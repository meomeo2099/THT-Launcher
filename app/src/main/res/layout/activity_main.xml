<?xml version="1.0" encoding="utf-8"?>
<!-- Thiết kế cho màn ngang 1920x720 @160dpi (= 1920x720dp); widget co theo kích thước thật -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Màn hình widget (HomeCanvas được thêm bằng code) -->
        <FrameLayout
            android:id="@+id/canvas_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp" />

        <!-- Dock -->
        <HorizontalScrollView
            android:id="@+id/dock_scroll"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/dock_bg"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Thanh công cụ khi sửa màn hình chính -->
    <LinearLayout
        android:id="@+id/edit_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/dock_bg"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <Button android:id="@+id/edit_add" style="@style/THT.Button" android:text="+ Thêm widget" />
        <Button android:id="@+id/edit_reset" style="@style/THT.Button" android:text="Bố cục mặc định" />
        <Button android:id="@+id/edit_done" style="@style/THT.Button.Accent" android:text="Xong" />
    </LinearLayout>

    <!-- Ngăn kéo ứng dụng -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/drawer_search"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:hint="Tìm ứng dụng"
                android:inputType="text"
                android:paddingHorizontal="20dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="20sp" />

            <Button android:id="@+id/drawer_close" style="@style/THT.Button" android:text="Đóng" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
